# ---------------------------------------------------------------------------
# NetSage AI - provider configuration
# Copy this file to ".env" and fill in ONE provider. Leave everything blank to
# run in zero-cost offline mock mode (the default).
# ---------------------------------------------------------------------------

# mock | groq | gemini | ollama | openai
NETSAGE_PROVIDER=mock

# --- Groq (free tier: https://console.groq.com/keys) -----------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (fully local: https://ollama.com  then: ollama pull llama3.1:8b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Any OpenAI-compatible endpoint ---------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
